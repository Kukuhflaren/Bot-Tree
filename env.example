# CARA PAKAI:
# 1) Salin file ini menjadi ".env" (tanpa .example)
# 2) Isi nilainya di file .env, JANGAN di file ini
# 3) JANGAN pernah upload, screenshot, atau kirim file .env ke siapa pun

# Mode: paper (simulasi lokal) | demo (akun demo Bitget) | live (uang asli)
MODE=demo

# Wajib diisi persis "SAYA_PAHAM_RISIKONYA" kalau MODE=live
LIVE_CONFIRM=

# Demo: aktifkan hanya dengan Demo API Key
DEMO_API=on
DEMO_CONFIRM=UJI_DEMO_SAYA_PAHAM

# Biarkan off sampai order/TP-SL/partial/cancel/restart Demo tervalidasi manual.
DEMO_LOOP_EXECUTION_VERIFIED=on

# Execution controls (initial experimental fee assumptions, basis points).
DEMO_MAKER_FEE_BPS=6
DEMO_TAKER_FEE_BPS=6
DEMO_MIN_NET_BPS=15
DEMO_MAX_SPREAD_BPS=10
DEMO_MIN_BOOK_DEPTH_MULTIPLE=5
DEMO_MAX_HOLD_HOURS=5
DEMO_BOOK_MAX_AGE_SECONDS=3

# Paper fills need trade-through confirmation and are capped by candle volume.
PAPER_FILL_THROUGH_BPS=1
PAPER_FILL_PARTICIPATION_PCT=1

# Dashboard kendali web: token acak rahasia untuk tombol kendali
# Jangan upload nilai aktual ke GitHub; isi hanya di .env tablet
BOT_CONTROL_TOKEN=

# Persetujuan live melalui Telegram (opsional untuk live)
# Buat bot dari @BotFather, ambil chat ID administrator yang tepercaya
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bitget (izin API: baca + trade saja, JANGAN aktifkan withdraw) ---
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# on = akun UTA (Unified Trading Account, API v3). Key UTA tidak bisa dipakai di API Classic (v2)
BITGET_UTA=on

# --- AI: pilih salah satu penyedia, isi key-nya saja ---
# off (default) = tidak ada panggilan AI; on = aktifkan AI untuk selector/penilai
USE_AI=off

# gemini | claude | grok | gpt
AI_PROVIDER=gemini

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Batas panggilan AI per hari (menjaga biaya)
AI_MODEL=gemini-3.5-flash-lite
AI_MAX_CALLS_PER_DAY=10
AI_MAX_TOKENS_PER_HARI=100000

# --- Parameter strategi Trend + Range Grid ---
# Timeframe candle: 5m (disarankan) | 15m | 30m
CANDLE_TIMEFRAME=5m

# Modal & risk (rekomendasi untuk modal kecil / belajar)
MODAL_DEMO_USDT=40
MODAL_LIVE_USDT=40
LEVERAGE=4
# Persen modal yang boleh dirugikan per setup (2.5% = konservatif)
RISK_PER_SETUP_PCT=2.5

# --- Klasifikasi tren ---
ADX_PERIOD=14
# ADX >= nilai ini = tren cukup kuat (boleh long/short)
ADX_TREND_MIN=18
# ADX < nilai ini = kandidat sideways
ADX_SIDEWAYS_MAX=18
# Sideways boleh masuk hanya jika (HH-HL) >= RANGE_MIN_ATR × ATR
RANGE_MIN_ATR=3.0

# --- Grid ATR arithmetic ---
# Jarak antar level grid = GRID_SPACING_ATR × ATR
GRID_SPACING_ATR=0.45
# Maksimal jumlah level yang dipasang
GRID_MAX_LEVELS=6
# SL di luar HL (long) / HH (short) = SL_BUFFER_ATR × ATR
SL_BUFFER_ATR=0.35

# Fee & syarat RR (setelah fee)
# Estimasi fee bolak-balik dalam persen harga (0.12 = 0.12%)
FEE_ROUNDTRIP_PCT=0.12
# Minimum Net RR setelah fee
RR_MIN=1.1
RISK_ATR_MIN=0.7
RISK_ATR_MAX=3.0

# Skor minimum (0-100) agar token dianggap layak
SCORE_MIN=40

# Time exit (jam) — posisi ditutup paksa setelah ini
MAX_HOLD_HOURS=3
DEMO_MAX_HOLD_HOURS=3

# Kompatibilitas (boleh biarkan)
TP_PERCENT=0.25
SL_POINTS=0
TP_MODE=struktur
TP_METHOD=sr
TP_ATR_PERCENT=100
SL_METHOD=atr
SL_ATR_PERCENT=35
NEAR_MODE=atr
NEAR_SR_PERCENT=0.5
NEAR_ATR_MULT=3.0

# --- Universe ---
# off    = tanpa watchlist
# prefer = watchlist DIUTAMAKAN masuk daftar_40, token lain tetap boleh (disarankan eksperimen)
# only   = HANYA token di watchlist.json
WATCHLIST_MODE=prefer
WATCHLIST_FILE=watchlist.json

# Token dengan volume 24 jam di bawah ini (USDT) diabaikan karena kurang likuid
PENYARING_VOL_MIN_USDT=1000000

# Dari token yang likuid, hanya N dengan volume terbesar yang diperiksa lebih dalam
PENYARING_TOP_VOLUME=100

# Jumlah token per sisi (bullish dan bearish) di daftar akhir
JUMLAH_PER_SISI=20
# Skor penyaring untuk pullback ke S/R, bukan momentum 24 jam.
# Gerakan di sekitar nilai ini (persen) tidak dihukum. Yang jauh lebih besar diturunkan.
UBAH_IDEAL_SKOR=4
# Di atas nilai ini skor dipotong lagi. 0 = tidak ada potongan tambahan.
UBAH_MAKS_SKOR=20

# on = buang kontrak Bitget isRwa (saham, ETF, indeks, komoditas sesi).
# Simbol yang ada di watchlist.json tetap lolos, misalnya NVDA atau SPCX.
EXCLUDE_RWA=on

# Kosongkan untuk mematikan blacklist saat eksperimen:
TOKEN_BLACKLIST=
# Contoh nanti (produksi):
# TOKEN_BLACKLIST=CSOP,CSOPSK,2L,2S,3L,3S,NVDA,TSLA,XAU,XAG,CL,BZ

# --- Pengaman ---
# on = order hanya dicatat di log, TIDAK dikirim ke Bitget (meniru --dry-run resmi Bitget)
# Ubah ke off hanya saat sudah siap uji demo/live
DRY_RUN=off

# Bot berhenti sendiri setelah rugi berturut-turut sebanyak ini (menghindari campur tangan emosi)
MAX_OPEN_TOKENS=1
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_LOSS_USDT=2

# Ubah ke on untuk menghentikan semua order baru
KILL_SWITCH=off
