# CARA PAKAI:
# 1) Salin file ini menjadi ".env" (tanpa .example)
# 2) Isi nilainya di file .env, JANGAN di file ini
# 3) JANGAN pernah upload, screenshot, atau kirim file .env ke siapa pun

# Mode: paper (simulasi lokal) | demo (akun demo Bitget) | live (uang asli)
MODE=paper
LIVE_CONFIRM=

# --- Bitget (izin: baca + trade saja, JANGAN withdraw) ---
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
BITGET_UTA=on

# --- AI (opsional; bot adalah hakim utama) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

AI_MAX_CALLS_PER_DAY=24
AI_MODEL=gemini-3.5-flash-lite

# --- Modal & ukuran posisi (Fase A) ---
MODAL_DEMO_USDT=10
MODAL_LIVE_USDT=5
LEVERAGE=5
# Persen modal sebagai margin per setup (default 5%)
RISK_PER_SETUP_PCT=5

# --- Strategi ---
TP_PERCENT=0.25
SL_POINTS=50
SCORE_MIN=50
RR_MIN=1.0
RISK_ATR_MIN=1.0
RISK_ATR_MAX=2.5
NEAR_MODE=atr
NEAR_SR_PERCENT=0.5
NEAR_ATR_MULT=2.5

# --- Universe (Fase A) ---
# only = hanya simbol di watchlist.json | off = semua minus blacklist
WATCHLIST_MODE=only
WATCHLIST_FILE=watchlist.json
PENYARING_VOL_MIN_USDT=1000000
PENYARING_TOP_VOLUME=100
JUMLAH_PER_SISI=20
UBAH_MAKS_SKOR=20
TOKEN_BLACKLIST=CSOP,CSOPSK,2L,2S,3L,3S,5L,5S,UP,DOWN,BULL,BEAR,NVDA,TSLA,AAPL,MSFT,GOOGL,META,AMZN,AMD,INTC,COIN,MSTR,QQQ,SPY,TQQQ,SQQQ,SOXL,SOXS,XAU,XAG,XAUT,PAXG,CL,BZ,NATGAS,COPPER,SP500,SPX

# --- Pengaman (Fase A) ---
DRY_RUN=on
MAX_OPEN_TOKENS=1
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_LOSS_USDT=2
KILL_SWITCH=off
