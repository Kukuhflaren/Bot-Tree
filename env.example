# CARA PAKAI:
# 1) Salin file ini menjadi ".env" (tanpa .example)
# 2) Isi nilainya di file .env, JANGAN di file ini
# 3) JANGAN pernah upload, screenshot, atau kirim file .env ke siapa pun

MODE=paper
LIVE_CONFIRM=

BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
BITGET_UTA=on

AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
AI_MAX_CALLS_PER_DAY=24
AI_MODEL=gemini-3.5-flash-lite

MODAL_DEMO_USDT=10
MODAL_LIVE_USDT=5
LEVERAGE=5
RISK_PER_SETUP_PCT=5

TP_PERCENT=0.25
SL_POINTS=50
SCORE_MIN=50
RR_MIN=1.0
RISK_ATR_MIN=1.0
RISK_ATR_MAX=2.5
NEAR_MODE=atr
NEAR_SR_PERCENT=0.5
NEAR_ATR_MULT=2.5

# --- Universe ---
# off    = tanpa watchlist
# prefer = watchlist DIUTAMAKAN masuk daftar_40, token lain tetap boleh (disarankan eksperimen)
# only   = HANYA token di watchlist.json
WATCHLIST_MODE=prefer
WATCHLIST_FILE=watchlist.json
PENYARING_VOL_MIN_USDT=1000000
PENYARING_TOP_VOLUME=100
JUMLAH_PER_SISI=20
UBAH_MAKS_SKOR=20
# Kosongkan untuk mematikan blacklist saat eksperimen:
TOKEN_BLACKLIST=
# Contoh nanti (produksi):
# TOKEN_BLACKLIST=CSOP,CSOPSK,2L,2S,3L,3S,NVDA,TSLA,XAU,XAG,CL,BZ

DRY_RUN=on
MAX_OPEN_TOKENS=1
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_LOSS_USDT=2
KILL_SWITCH=off
