# CARA PAKAI:
# 1) Salin file ini menjadi ".env" (tanpa .example)
# 2) Isi nilainya di file .env, JANGAN di file ini
# 3) JANGAN pernah upload, screenshot, atau kirim file .env ke siapa pun

# Mode: paper (simulasi lokal) | demo (akun demo Bitget) | live (uang asli)
MODE=paper
# Wajib diisi persis "SAYA_PAHAM_RISIKONYA" kalau MODE=live
LIVE_CONFIRM=

# --- Bitget (izin API: baca + trade saja, JANGAN aktifkan withdraw) ---
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# on = akun UTA (Unified Trading Account, API v3). Key UTA tidak bisa dipakai di API Classic (v2)
BITGET_UTA=on

# --- AI: pilih salah satu penyedia, isi key-nya saja ---
# gemini | claude | grok | gpt
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
# Batas panggilan AI per hari (menjaga biaya)
AI_MAX_CALLS_PER_DAY=24

# --- Parameter strategi ---
# Modal untuk paper/demo dan untuk live (dipilih otomatis sesuai MODE)
MODAL_DEMO_USDT=10
MODAL_LIVE_USDT=5
LEVERAGE=5
TP_PERCENT=0.25
SL_POINTS=50
SCORE_MIN=50
# Batas "dekat support/resistance" untuk syarat masuk bot, dua cara ukur:
# persen = jarak harga ke S1/R1 <= NEAR_SR_PERCENT persen
# atr    = jarak harga ke S1/R1 <= NEAR_ATR_MULT kali ATR (menyesuaikan volatilitas token)
NEAR_MODE=atr
NEAR_SR_PERCENT=0.5
NEAR_ATR_MULT=1.5

# --- Pengaman ---
# on = order hanya dicatat di log, TIDAK dikirim ke Bitget (meniru --dry-run resmi Bitget)
# Ubah ke off hanya saat sudah siap uji demo/live
DRY_RUN=on
# Bot berhenti sendiri setelah rugi berturut-turut sebanyak ini (menghindari campur tangan emosi)
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_LOSS_USDT=2
MAX_OPEN_TOKENS=1
# Ubah ke on untuk menghentikan semua order baru
KILL_SWITCH=off
