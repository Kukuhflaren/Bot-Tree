# CARA PAKAI:
# 1) Salin file ini menjadi ".env" (tanpa .example)
# 2) Isi nilainya di file .env, JANGAN di file ini
# 3) JANGAN pernah upload, screenshot, atau kirim file .env ke siapa pun

# Mode: paper (simulasi lokal) | demo (akun demo Bitget) | live (uang asli)
MODE=paper
# Wajib diisi persis "SAYA_PAHAM_RISIKONYA" kalau MODE=live
LIVE_CONFIRM=

# --- Bitget (izin API: baca + trade saja, JANGAN aktifkan withdraw) ---
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# on = akun UTA (Unified Trading Account, API v3). Key UTA tidak bisa dipakai di API Classic (v2)
BITGET_UTA=on

# --- AI: pilih salah satu penyedia, isi key-nya saja ---
# gemini | claude | grok | gpt
AI_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Batas panggilan AI per hari (menjaga biaya)
AI_MODEL=gemini-3.5-flash-lite
AI_MAX_CALLS_PER_DAY=10
AI_MAX_TOKENS_PER_HARI=100000

# --- Parameter strategi ---
MODAL_DEMO_USDT=10
MODAL_LIVE_USDT=5
LEVERAGE=5

# Persen modal sebagai margin per setup (default 5%)
RISK_PER_SETUP_PCT=5

# --- Strategi ---
# TP_PERCENT masih ada untuk kompatibilitas; TP utama sekarang di HH (bullish) / HL (bearish)
TP_PERCENT=0.25
SL_POINTS=50
SCORE_MIN=50

TP_MODE=sr_lawan
SL_BUFFER_ATR=0

# Minimum reward:risk per titik grid. Titik dengan RR di bawah ini ditolak.
RR_MIN=1.0
RISK_ATR_MIN=1.0
RISK_ATR_MAX=2.5

# Batas "dekat support/resistance" untuk syarat masuk bot, dua cara ukur:
# persen = jarak harga ke S1/R1 <= NEAR_SR_PERCENT persen
# atr    = jarak harga ke S1/R1 <= NEAR_ATR_MULT kali ATR (menyesuaikan volatilitas token)
NEAR_MODE=atr
NEAR_SR_PERCENT=0.5
NEAR_ATR_MULT=2.5

# --- Universe ---
# off    = tanpa watchlist
# prefer = watchlist DIUTAMAKAN masuk daftar_40, token lain tetap boleh (disarankan eksperimen)
# only   = HANYA token di watchlist.json
WATCHLIST_MODE=prefer
WATCHLIST_FILE=watchlist.json

# Token dengan volume 24 jam di bawah ini (USDT) diabaikan karena kurang likuid
PENYARING_VOL_MIN_USDT=1000000

# Dari token yang likuid, hanya N dengan volume terbesar yang diperiksa lebih dalam
PENYARING_TOP_VOLUME=100

# Jumlah token per sisi (bullish dan bearish) di daftar akhir
JUMLAH_PER_SISI=20
UBAH_MAKS_SKOR=20

# Kosongkan untuk mematikan blacklist saat eksperimen:
TOKEN_BLACKLIST=
# Contoh nanti (produksi):
# TOKEN_BLACKLIST=CSOP,CSOPSK,2L,2S,3L,3S,NVDA,TSLA,XAU,XAG,CL,BZ

# --- Pengaman ---
# on = order hanya dicatat di log, TIDAK dikirim ke Bitget (meniru --dry-run resmi Bitget)
# Ubah ke off hanya saat sudah siap uji demo/live
DRY_RUN=on

# Bot berhenti sendiri setelah rugi berturut-turut sebanyak ini (menghindari campur tangan emosi)
MAX_OPEN_TOKENS=1
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_LOSS_USDT=2

# Ubah ke on untuk menghentikan semua order baru
KILL_SWITCH=off
